# App
APP_NAME=Dami Beauty API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Firebase
FIREBASE_PROJECT_ID=dami-beauty-353b0
GOOGLE_APPLICATION_CREDENTIALS=./service-account-dev.json
# Emulator hosts (uncomment for local emulators)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# PayTR — official test mode (recommended once credentials arrive)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
# Local UI-only bypass without PayTR keys (never true on Railway/production)
PAYTR_ALLOW_DEV_MOCK=false

# URLs — BACKEND_URL must match Railway public URL for PayTR callback
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Shipping (kuruş: 100 = ₺1)
DEFAULT_SHIPPING_TRY=4900
FREE_SHIPPING_THRESHOLD_TRY=99999
GIFT_WRAP_PRICE_TRY=5000

# WhatsApp
WHATSAPP_NUMBER=905301224237

# Email (optional — SendGrid for reliable delivery)
SENDGRID_API_KEY=
FROM_EMAIL=orders@damibeauty.com

# Firebase Web API key (same as frontend NEXT_PUBLIC_FIREBASE_API_KEY)
FIREBASE_WEB_API_KEY=

# Low stock alert threshold
LOW_STOCK_DEFAULT=5

# Local dev without Firebase JSON: keep true until service-account-dev.json is added
USE_MOCK_DB=true

# Cloud deploy (Railway/Render): paste full JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# CORS_ALLOW_VERCEL=true
