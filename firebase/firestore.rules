rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Public read for active products and categories
    match /products/{productId} {
      allow read: if resource.data.active == true;
      allow write: if false; // All writes via Admin SDK (FastAPI)
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    match /instagram_posts/{postId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    // Orders: users read own orders only
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow create: if isOwner(userId);
      allow delete: if false;
    }

    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
