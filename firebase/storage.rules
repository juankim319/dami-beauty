rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Public product images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaigns/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instagram-cache/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
